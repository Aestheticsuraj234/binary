{
  "name": "binary",
  "private": true,
  "description": "Binary \u2014 an open-source personal AI assistant you run yourself.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "docker compose up -d && pnpm db:migrate && pnpm db:seed && pnpm browsers:install",
    "browsers:install": "pnpm --filter @binary/api exec playwright install chromium",
    "dev": "turbo run dev --filter=@binary/api --filter=@binary/web",
    "mobile": "pnpm --filter @binary/mobile start",
    "trigger:dev": "pnpm --filter @binary/api trigger:dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @binary/db db:migrate",
    "db:generate": "pnpm --filter @binary/db db:generate",
    "db:studio": "pnpm --filter @binary/db db:studio",
    "db:seed": "pnpm --filter @binary/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
