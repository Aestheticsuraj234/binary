{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "WEB_URL",
    "NEXT_PUBLIC_API_URL",
    "TRIGGER_SECRET_KEY",
    "E2B_API_KEY"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {},
    "test": {
      "cache": false,
      "dependsOn": ["@binary/db#db:migrate"]
    },
    "db:migrate": {
      "cache": false
    }
  }
}
