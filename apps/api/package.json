{
  "name": "@binary/api",
  "version": "0.0.0",
  "private": true,
  "description": "Binary API server: authentication today, agents and tools in later chapters.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx --env-file=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.23",
    "@binary/db": "workspace:*",
    "@binary/shared": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "better-auth": "^1.7.23",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@binary/config": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
