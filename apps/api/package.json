{
  "name": "@binary/api",
  "version": "0.0.0",
  "private": true,
  "description": "Binary API server: authentication today, agents and tools in later chapters.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx --env-file=../../.env scripts/seed.ts",
    "trigger:dev": "trigger dev --env-file ../../.env"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/mcp": "2.0.99",
    "@ai-sdk/openai": "^4.0.118",
    "@better-auth/expo": "^1.7.23",
    "@binary/db": "workspace:*",
    "@binary/shared": "workspace:*",
    "@e2b/code-interpreter": "2.9.0",
    "@hono/node-server": "^2.1.8",
    "@trigger.dev/sdk": "4.8.5",
    "ai": "^7.0.173",
    "better-auth": "^1.7.23",
    "hono": "^4.13.18",
    "playwright": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@binary/config": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@trigger.dev/build": "4.8.5",
    "@types/node": "^22.0.0",
    "trigger.dev": "4.8.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
